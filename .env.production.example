# Example for a deployed production host (copy to secret store / .env on the server).
# Never commit real passwords. Schema writes = hr only; dbo stays legacy CI + id source.

NODE_ENV=production
AUTH_DEV_BYPASS=false
# BYPASS_PASSWORD must stay unset

DB_SERVER=sqlmisis-prod.6273d55d722a.database.windows.net
DB_PORT=1433
DB_NAME=MYHR
DB_USER=
DB_PASSWORD=

HR_SCHEMA=hr
PUBLIC_JOBSITE_ID=1
DEFAULT_JOBSITE_ID=1

JWT_SECRET=
JWT_EXPIRES=18h

PORT=9520
HOST=0.0.0.0
CORS_ORIGIN=https://your-frontend-origin.example

MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Optional on the same host for cron sync (or run sync from a jump box):
# PROD_DB_SERVER=… (same as DB_SERVER)
# PROD_DB_PORT=1433
# PROD_DB_NAME=MYHR
# PROD_DB_USER=
# PROD_DB_PASSWORD=
# PROD_DB_SERVER_ALLOWLIST=sqlmisis-prod.6273d55d722a.database.windows.net
# CONFIRM_PROD_MIGRATE=YES
