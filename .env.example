# SQL Server — point at the same MyHR database used by myhr_api
# Local named instance example (or use host IP + DB_PORT if SQL Browser is off):
DB_SERVER=localhost\SQLEXPRESS
DB_PORT=1433
DB_NAME=MYHR
DB_USER=
DB_PASSWORD=

# Soft-launch / production app runtime: point DB_* at Azure (schema hr only).
# Keep a commented local Express block for rollback. Never commit real .env.
# See docs/AZURE_HR_DEPLOY.md Fase D and .env.production.example.
# DB_SERVER=sqlmisis-prod.6273d55d722a.database.windows.net
# DB_PORT=1433
# DB_NAME=MYHR
# DB_USER=
# DB_PASSWORD=
# AUTH_DEV_BYPASS=false


# JWT — use the same secret as local myhr_api tests, or a dedicated migration secret
JWT_SECRET=
JWT_EXPIRES=18h

# Optional: bypass password check for local auth tests only — never set in production
# BYPASS_PASSWORD=

# Server Configuration
NODE_ENV=development

# Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
PORT=9520
HOST=0.0.0.0

# Frontend origin (no path). Comma-separated for multiple origins.
CORS_ORIGIN=

# Legacy Ticketing / FLEET schema (modules disabled). Leave unset — HR uses HR_SCHEMA below.
# DB_SCHEMA=dbo

# Multi-site MyHR schema (scripts/hr/*.sql). Auth login/me reads hr.v_user_login.
HR_SCHEMA=hr

# Default jobsite id for portal / auth (matches hr.jobsites seed DEFAULT=1)
PUBLIC_JOBSITE_ID=1
DEFAULT_JOBSITE_ID=1

# Finger Pulse (Biostar linked-server ingest). Linked server name is in
# hr.finger_pulse_config — optional override of BY_JOBSITE for run_finger_pulse.js
# FINGER_PULSE_JOBSITE=1

# ---------------------------------------------------------------------------
# Azure MYHR production — READ-ONLY source for seed scripts only.
# Used by: seed_enums_structure_from_azure.js, seed_users_from_azure.js,
#          seed_attendance_from_azure.js, seed_workers_from_azure.js
# Guard: config/azureReadonly.js blocks INSERT/UPDATE/DELETE/DDL on this pool.
# Never set AZURE_DB_ALLOW_WRITE (that flag is rejected on purpose).
# ---------------------------------------------------------------------------
# AZURE_DB_SERVER=
# AZURE_DB_PORT=1433
# AZURE_DB_NAME=
# AZURE_DB_USER=
# AZURE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Production migrate / sync / verify (writable hr on Azure — NOT AZURE_DB_*).
# Used by: run_migrate_prod.js, sync_dbo_to_hr_prod.js, verify_id_alignment_prod.js
# Requires CONFIRM_PROD_MIGRATE=YES and PROD_DB_SERVER in PROD_DB_SERVER_ALLOWLIST.
# dbo stays the id source of truth; legacy_id kept on hr mirrors. See docs/AZURE_HR_DEPLOY.md.
# ---------------------------------------------------------------------------
# PROD_DB_SERVER=
# PROD_DB_PORT=1433
# PROD_DB_NAME=MYHR
# PROD_DB_USER=
# PROD_DB_PASSWORD=
# PROD_DB_SERVER_ALLOWLIST=
# CONFIRM_PROD_MIGRATE=YES
